# Shell: set -a; source .env; set +a  (Python does not auto-load .env.)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=1d
BOLLINGER_PERIOD=49
BOLLINGER_STDDEV=1.8
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
POSITION_SIZE=1
DRY_RUN=true
INITIAL_CASH=10000
HISTORY_LIMIT=200
POLL_SECONDS=5
API_TIMEOUT_SECONDS=10
READ_RETRIES=3
TRADER_DATA_DIR=data
# Optional STATE_PATH overrides the automatic dry-run/live path.
BINANCE_API_KEY=
BINANCE_API_SECRET=
UPBIT_BASE_URL=https://api.upbit.com
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STARTUP_HEALTH_ENABLED=true
STARTUP_NOTIFICATION_COOLDOWN_SECONDS=3600
# Optional STARTUP_HEALTH_STATE_PATH defaults beside the trading DB.
# BUILD_VERSION is injected by the image build; POD_NAME by Kubernetes.
