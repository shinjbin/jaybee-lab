DRY_RUN=false
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
BOLLINGER_PERIOD=49
BOLLINGER_STDDEV=1.8
POSITION_SIZE=1
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
HISTORY_LIMIT=200
TRADER_DATA_DIR=data
STARTUP_HEALTH_ENABLED=true
STARTUP_ORDER_TEST_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
